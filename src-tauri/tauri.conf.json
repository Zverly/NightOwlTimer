{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NightOwl Timer",
  "version": "0.1.0",
  "identifier": "com.nightowl.timer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NightOwl · 轻量定时助手",
        "width": 960,
        "height": 780,
        "resizable": false,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
