{
  "name": "nightowl-timer",
  "private": true,
  "version": "1.0.1",
  "description": "A lightweight Windows shutdown, sleep, and scheduling utility built with Tauri.",
  "author": "Zverly",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zverly/NightOwlTimer.git"
  },
  "homepage": "https://github.com/Zverly/NightOwlTimer#readme",
  "bugs": {
    "url": "https://github.com/Zverly/NightOwlTimer/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "lucide-vue-next": "^0.577.0",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.6"
  }
}
